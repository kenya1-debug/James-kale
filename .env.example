# ── Public (safe for the browser) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional analytics (loaded only after a visitor accepts the cookie banner). Set one or both.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
# Optional: Cloudflare Turnstile (leave both blank to rely on honeypot + rate limiting)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Server only (never prefix with NEXT_PUBLIC_) ──
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=onboarding@resend.dev
# "true" only after your sending domain is verified in Resend (emails the client a receipt)
SEND_CLIENT_CONFIRMATION=
# "true" puts the client's message text inside the notification email. Default (blank) keeps it in the dashboard only.
EMAIL_INCLUDE_DETAILS=
TURNSTILE_SECRET_KEY=
# Any long random string; salts the hashed IPs used for rate limiting
RATE_LIMIT_SALT=

# ── Only for `npm run types` (local, not needed on Vercel) ──
SUPABASE_PROJECT_ID=

# Set to 1 to trial the Content-Security-Policy in report-only mode (production builds)
CSP_REPORT_ONLY=
